  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "answer",
              "partial",
              "repeat",
              "request_skip",
              "cancel_skip",
              "skip",
              "finish"
            ],
            "title": "Action"
          },
          "text": {
            "type": "string",
            "maxLength": 20000,
            "title": "Text",
            "default": ""
          },
          "slot_id": {
            "type": "string",
            "title": "Slot Id"
          },
          "request_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "action",
          "slot_id",
          "request_id"
        ],
        "title": "Action"
      },
      "Body_extract_documents_extract_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_extract_documents_extract_post"
      },
      "Config": {
        "properties": {
          "candidate_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Candidate Name"
          },
          "job_title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Job Title"
          },
          "job_description": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 10,
            "title": "Job Description"
          },
          "resume_text": {
            "type": "string",
            "maxLength": 30000,
            "title": "Resume Text",
            "default": ""
          },
          "skills": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Skills"
          },
          "experience_level": {
            "type": "string",
            "title": "Experience Level",
            "default": "mid-level"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ],
            "title": "Difficulty",
            "default": "intermediate"
          },
          "question_count": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 30.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Question Count",
            "default": 10
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 2.0,
            "title": "Duration Minutes",
            "default": 25
          },
          "answer_seconds": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 15.0,
            "title": "Answer Seconds",
            "default": 120
          },
          "custom_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Custom Questions"
          },
          "categories": {
            "items": {
              "type": "string",
              "enum": [
                "technical",
                "scenario",
                "experience",
                "behavioral"
              ]
            },
            "type": "array",
            "minItems": 1,
            "title": "Categories",
            "default": [
              "technical",
